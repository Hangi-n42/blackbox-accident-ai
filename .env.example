# Optional settings for the new migration entry points.
# Shell source this file explicitly; the original project has no dotenv loader.
BLACKBOX_V6_DIR=artifacts/submissions/verify_v6
# Hugging Face public downloads do not require a token. Do not put tokens in Git.
# Set these to 1 for offline model loading; leave 0 while downloading public assets.
HF_HUB_OFFLINE=0
TRANSFORMERS_OFFLINE=0
HF_HUB_DISABLE_IMPLICIT_TOKEN=1
OMP_NUM_THREADS=2
MKL_NUM_THREADS=2
OPENBLAS_NUM_THREADS=2
